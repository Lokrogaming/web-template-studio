{
  "name": "sitesmith",
  "version": "0.2.0",
  "description": "SiteSmith – Desktop Marketplace-App fuer Website-Templates: browsen, .zip laden oder per Workflow automatisiert installieren (GitHub-Repo + Pages + Preview).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node test/rendertest.js && node test/nodetest.js",
    "test:renderer": "node test/rendertest.js",
    "test:node": "node test/nodetest.js",
    "test:node-full": "node test/nodetest.js --full",
    "vendor:icons": "node -e \"require('fs').copyFileSync('node_modules/lucide/dist/umd/lucide.min.js','renderer/vendor/lucide.min.js')\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --x64",
    "dist-portable": "electron-builder --win portable"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "lucide": "^1.54.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^30.1.2"
  },
  "build": {
    "appId": "dev.lokro.sitesmith",
    "productName": "SiteSmith",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "SiteSmith"
    }
  }
}
